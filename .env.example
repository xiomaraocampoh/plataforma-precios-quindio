# Copiar a .env (nunca versionar .env)
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=cambia-esta-clave-en-local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://precios:precios@localhost:5432/precios
REDIS_URL=redis://localhost:6379/0
CACHE_COMPARACION_TTL=60
LIMITE_REPORTES_HORA=30
SIPSA_BASE_URL=
SIPSA_TIMEOUT_S=5
# ---------- Correo transaccional: relé SMTP de Brevo (ADR-021) ----------
# La clave se crea en Brevo -> Settings -> SMTP & API -> pestaña SMTP -> «Generate a new SMTP key».
# Es la clave SMTP (empieza por «xsmtpsib-»), NO la clave de API («xkeysib-»).
# EMAIL_HOST_USER es el «Login» que muestra esa misma pestaña (termina en @smtp-brevo.com).
# Si la red bloquea el puerto 587, usa EMAIL_PORT=2525 (también con EMAIL_USE_TLS=True).
# Sin EMAIL_HOST el correo se imprime en la consola. Las pruebas siempre usan locmem.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-login@smtp-brevo.com
EMAIL_HOST_PASSWORD=pega-aqui-tu-clave-smtp
# El remitente debe estar verificado en Brevo -> Senders, Domains & Dedicated IPs -> Senders
DEFAULT_FROM_EMAIL=AhorraPues <remitente-verificado@ejemplo.com>
EMAIL_REPLY_TO=remitente-verificado@ejemplo.com
EMAIL_TIMEOUT=10
# Dirección pública del sitio para los enlaces de los correos (en producción, https://tu-dominio)
SITIO_URL=http://localhost:8000
# Contraseñas de cargar_demo (si se dejan vacías se generan y se muestran una vez)
DEMO_PASSWORD=
DEMO_ADMIN_PASSWORD=
# Búsqueda por foto con IA (ADR-022). Sin clave la función queda apagada y el escáner de código sigue.
ANTHROPIC_API_KEY=
RECONOCIMIENTO_MODELO=claude-opus-5-5
RECONOCIMIENTO_TIMEOUT_S=20
RECONOCIMIENTOS_POR_HORA=20
RECONOCIMIENTOS_ANONIMO_POR_HORA=10
RECONOCIMIENTOS_POR_DIA_TOTAL=300

# Límites de lectura por IP (M-16). NO subir en producción: solo para la prueba de carga con k6 desde una sola IP.
# LIMITE_ANONIMO=120/min
# LIMITE_USUARIO=240/min
