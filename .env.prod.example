# Plantilla de variables de PRODUCCIÓN. Copiar a .env.prod (que NUNCA se versiona):
#   cp .env.prod.example .env.prod
# y reemplazar cada valor «cambia-…». Para generar una clave aleatoria:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# ── Obligatorias ─────────────────────────────────────────────
SECRET_KEY=cambia-esta-clave-larga-y-aleatoria
# Solo letras y números o «-» y «_»: se usa dentro de una URL de conexión.
POSTGRES_PASSWORD=cambia-esta-clave-aleatoria
# «localhost» debe estar siempre: lo usa la comprobación de salud del contenedor.
ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio.com
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com

# ── Con valor por defecto ────────────────────────────────────
# HTTPS obligatorio. Poner False SOLO para verificar la imagen en local sin TLS.
FORZAR_HTTPS=True
WEB_PORT=8000
WEB_CONCURRENCY=3
CACHE_COMPARACION_TTL=60
LIMITE_REPORTES_HORA=30

# ── Correo (recuperar contraseña, RF-02) ─────────────────────
# Por defecto el correo se imprime en el registro del contenedor. Un despliegue real necesita
# SMTP, que todavía no se puede configurar desde el entorno (ver «Límites» en despliegue.md).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=AhorraPues <no-responder@localhost>

# ── Datos de ejemplo (solo si se ejecuta `cargar_demo`) ──────
# Si quedan vacías, el comando genera una clave aleatoria y la muestra una sola vez.
DEMO_PASSWORD=
DEMO_ADMIN_PASSWORD=

# ── Búsqueda por foto con IA (ADR-019; opcional) ─────────────
# Vacía = la función no aparece. Antes de activarla: aprobar el ADR y la política de datos.
ANTHROPIC_API_KEY=
RECONOCIMIENTO_MODELO=claude-opus-5-5
RECONOCIMIENTOS_POR_HORA=20
RECONOCIMIENTOS_ANONIMO_POR_HORA=10
RECONOCIMIENTOS_POR_DIA_TOTAL=300
